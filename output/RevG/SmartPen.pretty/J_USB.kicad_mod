(footprint "J_USB" (version 20221018) (generator pcbnew)
  (layer "F.Cu")
  (descr "Korean Hroparts TYPE-C-31-M-12 USB Type-C 16-Pin Receptacle (Hybrid SMT + Through-Hole Shell)")
  (tags "USB Type-C Receptacle HRO TYPE-C-31-M-12")
  (fp_text reference "J_USB" (at 0 -3.5) (layer "F.SilkS") (effects (font (size 0.8 0.8) (thickness 0.15))))
  (fp_text value "TYPE-C-31-M-12" (at 0 4.5) (layer "F.Fab") (effects (font (size 0.8 0.8) (thickness 0.15))))
  
  ;; Physical connector outer boundary outline
  (fp_line (start -4.47 -2.50) (end 4.47 -2.50) (stroke (width 0.15) (type solid)) (layer "F.SilkS"))
  (fp_line (start -4.47 3.80) (end -4.47 -2.50) (stroke (width 0.15) (type solid)) (layer "F.SilkS"))
  (fp_line (start 4.47 3.80) (end 4.47 -2.50) (stroke (width 0.15) (type solid)) (layer "F.SilkS"))
  (fp_line (start -4.47 3.80) (end 4.47 3.80) (stroke (width 0.15) (type solid)) (layer "F.SilkS"))
  
  ;; Courtyard
  (fp_line (start -5.20 -2.75) (end 5.20 -2.75) (stroke (width 0.05) (type solid)) (layer "F.CrtYd"))
  (fp_line (start 5.20 -2.75) (end 5.20 4.25) (stroke (width 0.05) (type solid)) (layer "F.CrtYd"))
  (fp_line (start 5.20 4.25) (end -5.20 4.25) (stroke (width 0.05) (type solid)) (layer "F.CrtYd"))
  (fp_line (start -5.20 4.25) (end -5.20 -2.75) (stroke (width 0.05) (type solid)) (layer "F.CrtYd"))

  ;; SMT Signal and Power Contacts (12 pads, 0.8mm pitch with 0.5mm center pair)
  (pad "1" smd rect (at -3.200 -1.500) (size 0.350 1.200) (layers "F.Cu" "F.Paste" "F.Mask"))
  (pad "2" smd rect (at -2.400 -1.500) (size 0.350 1.200) (layers "F.Cu" "F.Paste" "F.Mask"))
  (pad "3" smd rect (at -1.600 -1.500) (size 0.350 1.200) (layers "F.Cu" "F.Paste" "F.Mask"))
  (pad "5" smd rect (at -0.800 -1.500) (size 0.350 1.200) (layers "F.Cu" "F.Paste" "F.Mask"))
  (pad "7" smd rect (at -0.250 -1.500) (size 0.350 1.200) (layers "F.Cu" "F.Paste" "F.Mask"))
  (pad "9" smd rect (at 0.250 -1.500) (size 0.350 1.200) (layers "F.Cu" "F.Paste" "F.Mask"))
  (pad "6" smd rect (at 0.800 -1.500) (size 0.350 1.200) (layers "F.Cu" "F.Paste" "F.Mask"))
  (pad "10" smd rect (at 2.400 -1.500) (size 0.350 1.200) (layers "F.Cu" "F.Paste" "F.Mask"))
  (pad "12" smd rect (at 3.200 -1.500) (size 0.350 1.200) (layers "F.Cu" "F.Paste" "F.Mask"))

  ;; 4 Metal Through-Hole Shield Anchors (Pads 13-16 with oval slots for shell tabs)
  (pad "13" thru_hole oval (at -4.300 0.000) (size 1.200 2.000) (drill oval 0.600 1.400) (layers "*.Cu" "*.Mask"))
  (pad "14" thru_hole oval (at 4.300 0.000) (size 1.200 2.000) (drill oval 0.600 1.400) (layers "*.Cu" "*.Mask"))
  (pad "15" thru_hole oval (at -4.300 2.500) (size 1.200 2.000) (drill oval 0.600 1.400) (layers "*.Cu" "*.Mask"))
  (pad "16" thru_hole oval (at 4.300 2.500) (size 1.200 2.000) (drill oval 0.600 1.400) (layers "*.Cu" "*.Mask"))

  ;; 2 Mechanical Locating Pegs (NPTH)
  (pad "" np_thru_hole circle (at -2.890 0.850) (size 0.650 0.650) (drill 0.650) (layers "*.Cu" "*.Mask"))
  (pad "" np_thru_hole circle (at 2.890 0.850) (size 0.650 0.650) (drill 0.650) (layers "*.Cu" "*.Mask"))
)
